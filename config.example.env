# Copy this file to config.env and replace every sample network value.
# The three node addresses and the MetalLB pool must be unused fixed LAN values.

CONTROL_PLANE_NAME=k8s-control
CONTROL_PLANE_IP=192.0.2.10
WORKER1_NAME=k8s-worker1
WORKER1_IP=192.0.2.11
WORKER2_NAME=k8s-worker2
WORKER2_IP=192.0.2.12

POD_CIDR=192.168.0.0/16
METALLB_RANGE=192.0.2.240-192.0.2.245

KUBERNETES_MINOR=v1.36
CALICO_VERSION=v3.33.0
LONGHORN_VERSION=v1.13.0
METALLB_VERSION=v0.16.1

